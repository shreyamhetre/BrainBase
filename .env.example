# GitMore settings. Copy to .env and fill in your values: cp .env.example .env
# .env is git-ignored; never commit it.

# --- Database (Docker Compose creates it on first start; the backend connects with DATABASE_URL)
POSTGRES_USER=gitmore
POSTGRES_PASSWORD=change-me
POSTGRES_DB=company_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://gitmore:change-me@localhost:5432/company_db

# --- Language model (answers and the router). Any OpenAI-compatible API works.
OPENAI_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# US dollars per million tokens, used for cost in the usage log (GPT-4o mini list prices)
LLM_PRICE_INPUT_PER_M=0.15
LLM_PRICE_OUTPUT_PER_M=0.60

# --- Embedding and reranker models (BGE-M3, BGE reranker). Set to 1 after the first download
# so they always load from the local cache.
HF_HUB_OFFLINE=0

# --- Login. JWT_SECRET signs the login cookie: a random string of 32+ characters.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24
# Only emails at this domain can sign up or log in
ALLOWED_EMAIL_DOMAIN=gitmore.com

# --- Accounts created by backend/scripts/seed_users.py
ADMIN_EMAIL=you@gitmore.com
ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# --- Encrypts every token stored in the database (connectors and MCP servers).
#     python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it means re-entering those tokens in the app.
SECRETS_KEY=

# --- Background sync of connectors inside the API (0 turns it off)
SYNC_SCHEDULER=1

# --- Jev evidence gate (TypeSafe, https://console.typesafe.ai/keys). Empty = gate skipped.
TYPESAFE_API_KEY=

# --- Langfuse tracing (optional). The backend sends traces with these keys.
LANGFUSE_BASE_URL=http://localhost:3100
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Langfuse's own containers (docker-compose.langfuse.yml). Generate random values for the secrets.
LF_INIT_USER_EMAIL=admin@gitmore.local
LF_INIT_USER_PASSWORD=
LF_SALT=
LF_ENCRYPTION_KEY=          # 64 hex characters: openssl rand -hex 32
LF_NEXTAUTH_SECRET=
LF_POSTGRES_PASSWORD=
LF_CLICKHOUSE_PASSWORD=
LF_MINIO_PASSWORD=
LF_REDIS_PASSWORD=

# --- Demo Slack and GitLab, used ONLY by the setup scripts publish_synthetic.py and seed_connectors.py.
# The running app doesn't read these: connectors and MCP servers are added on the Connectors and MCP tools
# pages, and their tokens are stored encrypted in the database.
SLACK_BOT_TOKEN=xoxb-...
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=glpat-...
GITLAB_GROUP=your-group
